{
	"extends": "../../tsconfig.composite.base.json",
	"compilerOptions": {
		"skipLibCheck": true,
		"esModuleInterop": true,
		"lib": [
			"dom",
			"es2020"
		],
		"moduleResolution": "bundler",
		"module": "Preserve",
	},
	"include": [
		"./coverage/**/*.ts",
		"./graphics/graphics-test-cases.ts",
		"./graphics/generate-golden-content.ts",
		"./graphics/generate-test-cases.ts",
		"./graphics/utils.ts",
		"./graphics/helpers/**/*.ts",
		"./memleaks/**/*.ts",
		"./interactions/**/*.ts",
		"./helpers/**/*.ts",
		"../../src/index.ts",
		"../../src/standalone.ts",
		"../../src/api/**/*.ts",
		"../../src/drawing-tools/**/*.ts",
		"../../src/formatters/**/*.ts",
		"../../src/gui/**/*.ts",
		"../../src/helpers/**/*.ts",
		"../../src/model/**/*.ts",
		"../../src/plugins/**/*.ts",
		"../../src/renderers/**/*.ts",
		"../../src/typings/**/*.ts",
		"../../src/views/**/*.ts",
		"./*.ts"
	]
}
