{
	"extends": "./tsconfig.options.json",
	"compilerOptions": {
		"outDir": "lib/prod",
		"plugins": [
			{ "transform": "ts-transformer-strip-const-enums", "entrySourceFiles": ["./src/index.ts"] }
		],
		"stripInternal": true
	},
	"include": [
		"src/index.ts",
		"src/standalone.ts",
		"src/api/**/*.ts",
		"src/drawing-tools/**/*.ts",
		"src/formatters/**/*.ts",
		"src/gui/**/*.ts",
		"src/helpers/**/*.ts",
		"src/model/**/*.ts",
		"src/plugins/**/*.ts",
		"src/renderers/**/*.ts",
		"src/typings/**/*.ts",
		"src/views/**/*.ts"
	],
	"exclude": [
		"src/.storybook/**",
		"src/stories/**"
	]
}
