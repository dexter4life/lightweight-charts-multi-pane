{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/index.ts",
    "src/standalone.ts",
    "src/api",
    "src/drawing-tools",
    "src/formatters",
    "src/gui",
    "src/helpers",
    "src/model",
    "src/plugins",
    "src/renderers",
    "src/stories",
    "src/typings",
    "src/views"
  ]
}
